# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.
# Access token: create a Dropbox app (https://www.dropbox.com/developers/apps) with the
# sharing.read and files.content.read scopes, then generate a token on its settings page.
DROPBOX_TOKEN=
# Shared-folder link and password for the SoccerReplay-1988 videos (ask the team).
DROPBOX_SHARED_URL=
DROPBOX_LINK_PASSWORD=
